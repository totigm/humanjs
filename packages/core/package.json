{
  "name": "@humanjs/core",
  "version": "0.6.0",
  "description": "Personality system, timing math, types, and plugin contract for HumanJS.",
  "keywords": [
    "humanjs",
    "humanize",
    "playwright",
    "browser-automation"
  ],
  "author": "Gonzalo Muñoz <toti@eventurex.com.ar>",
  "license": "MIT",
  "homepage": "https://humanjs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totigm/humanjs.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/totigm/humanjs/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "clean": "rm -rf dist .turbo"
  },
  "publishConfig": {
    "access": "public"
  }
}
