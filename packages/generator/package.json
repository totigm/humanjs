{
  "name": "@humanjs/generator",
  "version": "0.2.0",
  "description": "Visual recorder for HumanJS — npx @humanjs/generator <url> records your clicks in a real browser and exports a clean, humanized Playwright test.",
  "keywords": [
    "humanjs",
    "playwright",
    "codegen",
    "test-generator",
    "recorder",
    "e2e",
    "browser-automation",
    "humanize",
    "playwright-test",
    "qa",
    "end-to-end-testing",
    "cli"
  ],
  "author": "Gonzalo Muñoz <toti@eventurex.com.ar>",
  "license": "MIT",
  "homepage": "https://humanjs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totigm/humanjs.git",
    "directory": "packages/generator"
  },
  "bugs": "https://github.com/totigm/humanjs/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "humanjs-generator": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && vite build",
    "dev": "tsup --watch",
    "dev:dashboard": "vite",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.injected.json && tsc --noEmit -p dashboard/tsconfig.json",
    "lint": "biome check .",
    "check:exports": "publint --strict",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@humanjs/core": "workspace:*",
    "@humanjs/playwright": "workspace:*",
    "playwright": "^1.62.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.0.3",
    "framer-motion": "^12.42.2",
    "happy-dom": "^20.10.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.7",
    "vite": "^8.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
